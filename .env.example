# Copy to .env and fill in.

# --- GitHub ---
# Fine-grained PAT or classic PAT with "repo" scope (read access is enough).
# Create one at: https://github.com/settings/tokens
# Optional for public repos (falls back to 60 unauthenticated requests/hour).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_API_BASE=https://api.github.com

# --- Google Cloud Source Repositories ---
# Auth comes from `gcloud auth login` — no key needed here.
# Optional: pin which gcloud account to use when several are logged in.
# GCLOUD_ACCOUNT=you@example.com
# Optional: supply an OAuth token directly instead of shelling out to gcloud
# (e.g. in CI). Overrides GCLOUD_ACCOUNT.
# GCLOUD_ACCESS_TOKEN=
# Where mirror clones are kept. Defaults to ./.cache/mirrors
# MIRROR_DIR=
# Timeout for any single git operation, in seconds.
# GIT_TIMEOUT_SECONDS=240

# --- Server ---
CACHE_TTL_SECONDS=120
MAX_CONCURRENCY=8
HOST=127.0.0.1
PORT=8000
